# ==========================================
# SUPABASE CONFIGURATION TEMPLATE
# Replace placeholder values in your local .env.local file
# ==========================================

# 1. Supabase Project URL
# Find in Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous API Key
# Find in Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (Optional / Server-only)
# Keep strictly secret on server! NEVER expose with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Exchange Rate API Key (Server-side only — do NOT prefix with NEXT_PUBLIC_)
# Provider: ExchangeRate-API  →  https://www.exchangerate-api.com/
# Sign up for a free account (1,500 requests/month free tier).
# The key is used ONLY in the server-side /api/exchange-rates route.
# Without this key the app falls back to hardcoded rates automatically.
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key-here

# 6. CoinGecko API key (optional; server-side only)
# Provider: CoinGecko Simple Price API. Without a key the keyless public API is used.
COINGECKO_API_KEY=your-coingecko-api-key-here
